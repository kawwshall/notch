{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notch",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "notch"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notch",
      "database_id": "e993ae0a-f7d6-41c4-8cfa-a0ca4bc69a3c",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  },
  "account_id": "b1c1b3933212ea667249ce45a5858855"
}
